# Deploy target for scripts/build-production.sh --deploy
#
# Copy this to .env.deploy (gitignored) and fill in the real values:
#   cp .env.deploy.sample .env.deploy
#
# .env.deploy must never be committed — it points at your production server.

# DirectAdmin panel SSH user
WAYAZ_SSH_USER=your-panel-user

# Panel hostname or IP address
WAYAZ_SSH_HOST=your-panel-host

# Panel SSH port
WAYAZ_SSH_PORT=22

# Private key used for deploy auth. The matching public key must be in the
# panel user's ~/.ssh/authorized_keys. Leave empty to fall back to
# ssh-agent / ~/.ssh/config.
WAYAZ_SSH_KEY=$HOME/.ssh/wayaz_deploy

# App directory under the panel user's home
WAYAZ_DEPLOY_PATH=wayaz
