# ==============================================================================
# Django Backend Environment Configuration
# ==============================================================================
# Copy to backend/.env and adjust. Values shown are safe local-dev defaults.
# The full production reference lives in docs/deployment-guide.md.

# Core Settings ----------------------------------------------------------------
# Generate a real one for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# The dev value below only works while DEBUG=True; with DEBUG off the server
# refuses to boot using it.
SECRET_KEY=dev-secret-key-change-in-production-wayaz
DEBUG=True

# Comma-separated hostnames the backend answers on (localhost only by
# default). Add your LAN demo IP, ngrok domain, and api.<domain> as needed.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed by CORS (the Next.js storefront).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated origins trusted for CSRF-protected POSTs (Django admin).
# CSRF_TRUSTED_ORIGINS=https://wayaz.co.ke,https://api.wayaz.co.ke

# Database (MariaDB/MySQL - the cPanel/DirectAdmin server has no PostgreSQL)
DB_NAME=wayaz
DB_USER=wayaz
DB_PASSWORD=wayaz_secret
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# HTTPS posture - enable once DNS + SSL are live (see docs/deployment-guide.md)
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# True when Apache/DirectAdmin terminates TLS and proxies to gunicorn:
# TRUST_X_FORWARDED_PROTO=true
# Enable only after the domain serves HTTPS everywhere:
# SECURE_HSTS_SECONDS=31536000

# Media uploads (product photos). Defaults to backend/media/ locally;
# production points it inside the Apache-served document root so Apache
# serves /media/* directly (see docs/deployment-guide.md + backend/.htaccess).
# MEDIA_ROOT=/home/USER/domains/api.example.com/public_html/media

# Email (order confirmations)
# For production, use django.core.mail.backends.smtp.EmailBackend with SMTP credentials
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Wayaz <orders@wayaz.co.ke>

# Merchant new-order notifications (a copy of every new order; skipped when empty)
MANAGER_EMAIL=owner@example.com

# SMTP against a cPanel mailbox - production only, e.g.:
# EMAIL_HOST=mail.yourdomain.com
# EMAIL_PORT=465                # 465 = implicit TLS, 587 = STARTTLS
# EMAIL_HOST_USER=orders@yourdomain.com
# EMAIL_HOST_PASSWORD=mailbox_password
# EMAIL_USE_SSL=true            # for 465
# EMAIL_USE_TLS=false           # true + EMAIL_USE_SSL=false for 587
# EMAIL_TIMEOUT=10

# Log verbosity (DEBUG, INFO, WARNING, ...)
# LOG_LEVEL=INFO

# Base URL of the Next.js storefront (password-reset links, etc.)
FRONTEND_URL=http://127.0.0.1:3000

# Customer Service
WHATSAPP_SUPPORT_NUMBER=254700000000

# ==============================================================================
# Safaricom M-Pesa Daraja Payment Gateway
# ==============================================================================
# Environments: "mock" (offline test) | "sandbox" (Daraja test) | "production" (live)
MPESA_ENVIRONMENT=mock

# Daraja API Credentials (obtain from https://developer.safaricom.co.ke/)
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Shortcode: 174379 for sandbox test paybill, or your live Paybill / Till number
MPESA_SHORTCODE=174379

# Passkey: Standard Daraja sandbox passkey below; replace with live passkey in production
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Shared secret embedded in the callback URL path (required outside mock mode).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MPESA_CALLBACK_SECRET=

# Public HTTPS webhook URL where Safaricom posts payment results.
# MUST end with /<MPESA_CALLBACK_SECRET>/ - the token is compared in constant
# time and callbacks without it are rejected (403).
# For local testing via ngrok: https://<your-subdomain>.ngrok-free.app/api/v1/payments/mpesa/callback/<secret>/
# For production: https://api.wayaz.co.ke/api/v1/payments/mpesa/callback/<secret>/
MPESA_CALLBACK_URL=https://api.wayaz.co.ke/api/v1/payments/mpesa/callback/
