# ==============================================================================
# Django Backend - Production Environment Configuration (DirectAdmin)
# ==============================================================================
# Copy this file to backend/.env when deploying to /home/wayazcok/wayaz/backend/

# Core Django Settings
SECRET_KEY=REPLACE_WITH_A_SECRET_KEY
DEBUG=false

# Allowed Hostnames
ALLOWED_HOSTS=api.wayaz.co.ke,wayaz.co.ke,localhost,127.0.0.1

# Cross-Origin Resource Sharing (CORS) & CSRF
CORS_ALLOWED_ORIGINS=https://wayaz.co.ke
CSRF_TRUSTED_ORIGINS=https://wayaz.co.ke,https://api.wayaz.co.ke

# Database (DirectAdmin MySQL / MariaDB)
DB_NAME=wayazcok_wayaz
DB_USER=wayazcok_wayazcok
DB_PASSWORD=REPLACE_WITH_YOUR_DB_PASSWORD
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# HTTPS Posture (LiteSpeed terminates SSL and passes X-Forwarded-Proto)
TRUST_X_FORWARDED_PROTO=true
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000

# Media Uploads (Served directly by LiteSpeed Web Server from public_html/media)
MEDIA_ROOT=/home/wayazcok/domains/api.wayaz.co.ke/public_html/media

# Email (DirectAdmin SMTP Mailbox)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.wayaz.co.ke
EMAIL_PORT=587
EMAIL_HOST_USER=info@wayaz.co.ke
EMAIL_HOST_PASSWORD=REPLACE_WITH_MAILBOX_PASSWORD
EMAIL_USE_SSL=false
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Wayaz <info@wayaz.co.ke>
MANAGER_EMAIL=info@wayaz.co.ke

# Storefront URL & Customer Service
FRONTEND_URL=https://wayaz.co.ke
WHATSAPP_SUPPORT_NUMBER=254700000000

# Log Verbosity
LOG_LEVEL=INFO

# ==============================================================================
# Safaricom M-Pesa Daraja Payment Gateway
# ==============================================================================
# Environments: "sandbox" (testing) | "production" (live)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Callback URL and secret token
MPESA_CALLBACK_SECRET=REPLACE_WITH_CALLBACK_SECRET
MPESA_CALLBACK_URL=https://api.wayaz.co.ke/api/v1/payments/mpesa/callback/REPLACE_WITH_CALLBACK_SECRET/
