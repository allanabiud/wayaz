# ==============================================================================
# Next.js Storefront Environment Configuration
# ==============================================================================

# Headless Django Backend API URL
# Development: http://127.0.0.1:8000
# LAN / Testing: http://192.168.1.138:8000
# Production: LEAVE EMPTY - the browser stays same-origin and Next's
# rewrites proxy /api/v1/* and /media/* to the backend (set this to
# https://api.wayaz.co.ke only if you deliberately want to bypass the proxy).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Server-side backend address for SSR/build-time fetches (used by the
# server bundle only - never inlined into client JS). Production:
# http://127.0.0.1:8000 (backend on the same box). Unset falls back to
# NEXT_PUBLIC_API_URL, then 127.0.0.1:8000.
API_PROXY_URL=http://127.0.0.1:8000

# Dev-server origins allowed for LAN device testing (comma-separated), e.g.
# http://192.168.1.138:3000. Unset disables extra origins.
ALLOWED_DEV_ORIGINS=

# WhatsApp Support Number for direct customer order inquiries and dispatch
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000

# Public site URL - used for canonical/OG/sitemap/robots links.
# Production: https://wayaz.co.ke
NEXT_PUBLIC_SITE_URL=http://localhost:3000
