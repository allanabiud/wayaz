# ==============================================================================
# Next.js Frontend - Production Environment Configuration (DirectAdmin)
# ==============================================================================

# Browser API endpoint: Leave EMPTY so browser requests stay same-origin (/api/v1/...)
# Next.js rewrites proxy /api/v1/* and /media/* to API_PROXY_URL.
NEXT_PUBLIC_API_URL=

# Server-side rewrite destination (DirectAdmin API subdomain)
API_PROXY_URL=https://api.wayaz.co.ke

# Public canonical site URL
NEXT_PUBLIC_SITE_URL=https://wayaz.co.ke

# Customer Service WhatsApp Number (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000
